# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в репозиторий не коммитится (см. .gitignore).

# --- Django ---
SECRET_KEY=django-insecure-change-me
DEBUG=True

# --- PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=store_db
DB_USER=store_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
